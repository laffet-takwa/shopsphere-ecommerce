POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
SHOPSPHERE_ADMIN_EMAIL=admin@shopsphere.local
SHOPSPHERE_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
MONGODB_URI=mongodb://mongodb:27017/shopsphere_inventory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PARTITIONS=3
# Orders above this amount are declined by the simulated processor, which exercises the
# payment.failed -> order cancelled -> stock released path.
PAYMENT_DECLINE_ABOVE_AMOUNT=10000
ELASTIC_PASSWORD=replace-for-nonlocal-deployments
VITE_API_URL=http://localhost:8080