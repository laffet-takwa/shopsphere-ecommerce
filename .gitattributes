# Normalise line endings so shell scripts run on any contributor's machine.
#
# Without this, core.autocrlf=true on Windows rewrites *.sh to CRLF, and bash then fails with
# "set: pipefail: invalid option name" or "$'\r': command not found" when the script is mounted
# into a container. That is not cosmetic: a CRLF shell script breaks the Kafka topic provisioning
# step, which every service waits on.
* text=auto

*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.js text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.vue text eol=lf
*.ts text eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
